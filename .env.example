# Firebase web app configuration
KAIRO_FIREBASE_API_KEY=
KAIRO_FIREBASE_PROJECT_ID=
KAIRO_FIREBASE_AUTH_DOMAIN=
KAIRO_FIREBASE_APP_ID=

# Deployed, private Cloudflare R2 Worker
KAIRO_R2_WORKER_URL=
KAIRO_BACKUP_PASSPHRASE=

# Optional: defaults are ~/.claude/settings.json and ~/.codex/config.toml.
# Credentials and model/provider settings remain in those CLI files.
KAIRO_CLAUDE_SETTINGS_FILE=
KAIRO_CODEX_CONFIG_FILE=

# Optional: restrict this device to one provider. Clear to enable provider switching.
KAIRO_ACTIVE_PROVIDER=

# Optional: both emulators must be configured together.
KAIRO_FIREBASE_AUTH_EMULATOR=
KAIRO_FIREBASE_FIRESTORE_EMULATOR=
